type User implements Node @goModel(model: "workbench/graphql-app/graph/model.User") {
  id: ID!
  name: String!
  email: String!
  creationDate: Date!
}

input CreateUserInput {
  name: String!
  password: String!
  email: String!
  creation_date: Date!
}

input UpdateUserInput {
  id: ID!
  name: String
  email: String
}
