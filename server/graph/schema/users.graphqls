type User implements Node @goModel(model: "workbench/graphql-app/graph/model.User") {
  id: ID!
  name: String!
  email: String!
  avatar: String! @goField(forceResolver: true)
  createdAt: Date! @goField(forceResolver: true)
}

type Token @goModel(model: "workbench/graphql-app/graph/model.Token"){
  token: String!
  expired_at: Date!
}

input CreateUserInput {
  name: String!
  password: String!
  email: String!
}

input UpdateUserInput {
  id: ID!
  name: String
  email: String
}
